{
  "manifest_version": 3,
  "name": "Rightmove Bulk Scraper",
  "version": "0.1.0",
  "description": "Scrape price, beds, size, tenure and more for every listing on a Rightmove search results page, with CSV export.",
  "permissions": ["scripting", "tabs", "downloads", "storage", "offscreen"],
  "host_permissions": [
    "https://www.rightmove.co.uk/*",
    "https://api.postcodes.io/*",
    "https://media.rightmove.co.uk/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rightmove Bulk Scraper"
  },
  "content_scripts": [
    {
      "matches": ["https://www.rightmove.co.uk/*find.html*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
